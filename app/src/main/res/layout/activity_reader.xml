<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/readerDrawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/readerRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/readerScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <TextView
                android:id="@+id/chapterContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="22dp"
                android:paddingTop="22dp"
                android:paddingEnd="22dp"
                android:paddingBottom="48dp"
                android:textIsSelectable="false" />
        </ScrollView>

        <TextView
            android:id="@+id/pageTransitionView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="48dp"
            android:textIsSelectable="false"
            android:visibility="gone" />

        <TextView
            android:id="@+id/readerTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="22dp"
            android:layout_marginBottom="12dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

        <TextView
            android:id="@+id/readerBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="22dp"
            android:layout_marginBottom="12dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

        <LinearLayout
            android:id="@+id/readerToolbar"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_gravity="top"
            android:background="#E61E1A19"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="64dp"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="退出"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="#F0ECE6" />

            <TextView
                android:id="@+id/chapterTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="#F0ECE6"
                android:textStyle="bold" />

            <Space
                android:layout_width="64dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chapterNav"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_gravity="bottom"
            android:background="#E61E1A19"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="16dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/previousChapterButton"
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="上一章"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="#D8D0C8" />

                <ProgressBar
                    android:id="@+id/novelProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:max="10000"
                    android:progress="0"
                    android:progressTint="#F0ECE6"
                    android:progressBackgroundTint="#5F5A55" />

                <TextView
                    android:id="@+id/nextChapterButton"
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="下一章"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="#D8D0C8" />
            </LinearLayout>

            <TextView
                android:id="@+id/pageIndicator"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="#D8D0C8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="亮度"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="#D8D0C8" />

                <SeekBar
                    android:id="@+id/brightnessSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="#F0ECE6"
                    android:thumbTint="#F0ECE6" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/bookmarkButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="收藏"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="#D8D0C8" />

                <TextView
                    android:id="@+id/catalogButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="目录"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="#D8D0C8" />

                <TextView
                    android:id="@+id/settingsButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="设置"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="#D8D0C8" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_gravity="bottom"
            android:background="#F01E1A19"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:paddingBottom="18dp"
            android:visibility="gone">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:text="阅读设置"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="#F0ECE6"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/pagedModeButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="#5F5A5A"
                            android:gravity="center"
                            android:text="翻页"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="#F0ECE6" />

                        <TextView
                            android:id="@+id/scrollModeButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="#5F5A5A"
                            android:gravity="center"
                            android:text="滚动"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="#F0ECE6" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/chapterSplitLabel"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:text="选择分章关键词"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="#D8D0C8" />

                    <TextView
                        android:id="@+id/chapterSplitButton"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="#5F5A5A"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="默认（第X章/第x章）"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="#F0ECE6" />

                    <TextView
                        android:id="@+id/textSizeLabel"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:text="字号：19"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="#D8D0C8" />

                    <SeekBar
                        android:id="@+id/textSizeSeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:max="16"
                        android:progress="5"
                        android:progressTint="#F0ECE6"
                        android:thumbTint="#F0ECE6" />

                    <TextView
                        android:id="@+id/lineSpacingLabel"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:text="行距：1.5"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="#D8D0C8" />

                    <SeekBar
                        android:id="@+id/lineSpacingSeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:max="10"
                        android:progress="3"
                        android:progressTint="#F0ECE6"
                        android:thumbTint="#F0ECE6" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:text="字体"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="#D8D0C8" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/systemFontButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="#5F5A5A"
                            android:gravity="center"
                            android:text="系统"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="#F0ECE6" />

                        <TextView
                            android:id="@+id/serifFontButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="#5F5A5A"
                            android:gravity="center"
                            android:text="衬线"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="#F0ECE6" />

                        <TextView
                            android:id="@+id/monoFontButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="#5F5A5A"
                            android:gravity="center"
                            android:text="等宽"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="#F0ECE6" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/paragraphSpacingLabel"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:text="段距：0"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="#D8D0C8" />

                    <SeekBar
                        android:id="@+id/paragraphSpacingSeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:max="12"
                        android:progress="0"
                        android:progressTint="#F0ECE6"
                        android:thumbTint="#F0ECE6" />

                    <TextView
                        android:id="@+id/firstLineIndentLabel"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:text="首行缩进：2字"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="#D8D0C8" />

                    <SeekBar
                        android:id="@+id/firstLineIndentSeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:max="4"
                        android:progress="2"
                        android:progressTint="#F0ECE6"
                        android:thumbTint="#F0ECE6" />

                    <TextView
                        android:id="@+id/pageMarginLabel"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:text="页边距：22"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="#D8D0C8" />

                    <SeekBar
                        android:id="@+id/pageMarginSeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:max="28"
                        android:progress="10"
                        android:progressTint="#F0ECE6"
                        android:thumbTint="#F0ECE6" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:text="翻页方式"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="#D8D0C8" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/slideTurnButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="#5F5A5A"
                            android:gravity="center"
                            android:text="滑动"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="#F0ECE6" />

                        <TextView
                            android:id="@+id/simulatedTurnButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="#5F5A5A"
                            android:gravity="center"
                            android:text="仿真"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="#F0ECE6" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/lightThemeButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="#5F5A5A"
                            android:gravity="center"
                            android:text="浅色"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="#F0ECE6" />

                        <TextView
                            android:id="@+id/darkThemeButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="#5F5A5A"
                            android:gravity="center"
                            android:text="深色"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="#F0ECE6" />

                        <TextView
                            android:id="@+id/eyeThemeButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="#5F5A5A"
                            android:gravity="center"
                            android:text="护眼"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="#F0ECE6" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/paperThemeButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="#5F5A5A"
                            android:gravity="center"
                            android:text="纸张"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="#F0ECE6" />

                        <TextView
                            android:id="@+id/grayThemeButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="#5F5A5A"
                            android:gravity="center"
                            android:text="灰白"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="#F0ECE6" />

                        <TextView
                            android:id="@+id/greenThemeButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="#5F5A5A"
                            android:gravity="center"
                            android:text="墨绿"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="#F0ECE6" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/settingsDoneButton"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="end|center_vertical"
                        android:text="完成"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="#D8C6FF" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chapterSplitOptions"
            android:layout_width="match_parent"
            android:layout_height="306dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_marginBottom="360dp"
            android:background="#F0332D2A"
            android:elevation="10dp"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/chapterSplitDefaultOption"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="默认（第X章/第x章）"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="#F0ECE6" />

            <TextView
                android:id="@+id/chapterSplitChineseOption"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="第X章（第一章）"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="#F0ECE6" />

            <TextView
                android:id="@+id/chapterSplitArabicOption"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="第x章（第1章）"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="#F0ECE6" />

            <TextView
                android:id="@+id/chapterSplitMarkOption"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="x、（1、）"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="#F0ECE6" />

            <TextView
                android:id="@+id/chapterSplitChapterOption"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="chapter x（chapter1）"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="#F0ECE6" />

            <TextView
                android:id="@+id/chapterSplitSectionOption"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="第X节/第x节"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="#F0ECE6" />

            <TextView
                android:id="@+id/chapterSplitVolumeOption"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="第X卷/第x卷"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="#F0ECE6" />

            <TextView
                android:id="@+id/chapterSplitPrologueOption"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="序章/楔子/后记"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="#F0ECE6" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/reader_bg_light"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="36dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/drawerBookTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingBottom="22dp"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/drawerTabs"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bookmarksTab"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="书签"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                <View
                    android:id="@+id/bookmarksIndicator"
                    android:layout_width="56dp"
                    android:layout_height="3dp"
                    android:background="#D9645D"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/catalogTab"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="目录"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="#B95A52"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/catalogIndicator"
                    android:layout_width="56dp"
                    android:layout_height="3dp"
                    android:background="#D9645D" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/notesTab"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="笔记"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                <View
                    android:id="@+id/notesIndicator"
                    android:layout_width="56dp"
                    android:layout_height="3dp"
                    android:background="#D9645D"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/emptyBookmarksView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="64dp"
            android:text="还没有书签"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bookmarksRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="18dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/notesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="18dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/catalogRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="18dp" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
