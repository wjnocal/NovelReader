<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="28dp"
    app:cardBackgroundColor="#80FFFFFF"
    app:cardCornerRadius="3dp"
    app:cardElevation="4dp"
    app:strokeColor="#80FFFFFF"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <FrameLayout
                android:id="@+id/bookCover"
                android:layout_width="match_parent"
                android:layout_height="142dp"
                android:background="#55FFFFFF"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/bookCoverImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/bookCoverTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="3"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="#111111"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bookMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="#222222" />
            </FrameLayout>

            <TextView
                android:id="@+id/bookTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="#111111"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bookProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="#222222" />
        </LinearLayout>

        <ImageView
            android:id="@+id/pinnedIndicator"
            android:layout_width="24dp"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:elevation="8dp"
            android:src="@drawable/ic_pinned_bookmark"
            android:translationZ="8dp"
                android:visibility="gone" />

        <TextView
            android:id="@+id/bookStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:background="#DDB95A52"
            android:gravity="center"
            android:minWidth="46dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
