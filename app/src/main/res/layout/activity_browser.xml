<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/browserRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F0EA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FFFFFCF8"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/browserBack"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="‹"
                android:textColor="#211F1D"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/browserForward"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="›"
                android:textColor="#211F1D"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/browserRefresh"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="↻"
                android:textColor="#211F1D"
                android:textSize="22sp" />

            <EditText
                android:id="@+id/browserAddress"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bottom_nav_pill_background"
                android:hint="网址或小说名"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:selectAllOnFocus="true"
                android:textColor="#211F1D"
                android:textColorHint="#8A817A"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/browserGo"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="前往"
                android:textColor="#B95A52"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/browserProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressTint="#B95A52" />

        <WebView
            android:id="@+id/browserWebView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/onlineReaderBall"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="22dp"
        android:background="@drawable/online_reader_ball_background"
        android:elevation="14dp"
        android:gravity="center"
        android:padding="8dp"
        android:text="在线\n阅读"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />
</FrameLayout>
