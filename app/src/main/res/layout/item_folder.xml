<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="14dp"
    android:paddingEnd="6dp"
    android:paddingBottom="14dp">

    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="88dp">

        <View
            android:layout_width="72dp"
            android:layout_height="56dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="4dp"
            android:background="#D9E7FF" />

        <View
            android:layout_width="78dp"
            android:layout_height="58dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:background="#C8DAFA" />

        <TextView
            android:id="@+id/folderBadge"
            android:layout_width="84dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="#F0D981"
            android:gravity="center"
            android:text="分组"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/folderCoverGrid"
            android:layout_width="72dp"
            android:layout_height="52dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="6dp"
            android:columnCount="2"
            android:padding="3dp"
            android:rowCount="2">

            <TextView
                android:id="@+id/folderCoverOne"
                android:layout_width="31dp"
                android:layout_height="22dp"
                android:layout_margin="1dp"
                android:background="#F7E9AE"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#5C4720"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/folderCoverTwo"
                android:layout_width="31dp"
                android:layout_height="22dp"
                android:layout_margin="1dp"
                android:background="#F3D98B"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#5C4720"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/folderCoverThree"
                android:layout_width="31dp"
                android:layout_height="22dp"
                android:layout_margin="1dp"
                android:background="#EBCB70"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#5C4720"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/folderCoverFour"
                android:layout_width="31dp"
                android:layout_height="22dp"
                android:layout_margin="1dp"
                android:background="#DDBA62"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#5C4720"
                android:textSize="9sp"
                android:textStyle="bold" />
        </GridLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/folderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textColor="#111111"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/folderCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="#777777" />

        <TextView
            android:id="@+id/folderSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="#777777" />
    </LinearLayout>

    <TextView
        android:id="@+id/folderMore"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="···"
        android:textColor="#888888"
        android:textSize="26sp" />

    <ImageView
        android:id="@+id/folderPinnedIndicator"
        android:layout_width="22dp"
        android:layout_height="31dp"
        android:layout_marginStart="2dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_pinned_bookmark"
        android:visibility="gone" />
</LinearLayout>
